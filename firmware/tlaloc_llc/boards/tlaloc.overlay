/*
 * Señales que usa la app (el hardware está en boards/omrover/tlaloc).
 */
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	zephyr,user {
		/* DRV8833 del gripper: IN1 eMIOS1 ch3 (PTA13), IN2 eMIOS1 ch10 (PTA27),
		 * 20 kHz; nSLEEP PTA14 (alto = activo); nFAULT PTE2 = gpioe_l 2 (EIRQ2),
		 * colector abierto: pull-up interno aquí (gpio_pin_configure borra el de
		 * pinctrl). */
		pwms = <&emios1_pwm 3 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&emios1_pwm 10 PWM_USEC(50) PWM_POLARITY_NORMAL>;
		pwm-names = "grip_in1", "grip_in2";
		grip-nsleep-gpios = <&gpioa_l 14 GPIO_ACTIVE_HIGH>;
		grip-fault-gpios = <&gpioe_l 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* ACS712 en ADC0 precisión ch0 (PTD1) */
		io-channels = <&adc0 0>;
		/* INT de la BNO080, activo bajo, PTA21 = gpioa_h 5 (EIRQ3). El pull-up
		 * va aquí: gpio_pin_configure() borra el de pinctrl. */
		imu-int-gpios = <&gpioa_h 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* Paro físico: botón NC entre 3.3 V y PTB21, PTB21 = gpiob_h 5 (EIRQ8).
		 * Activo bajo: botón presionado o cable abierto -> pull-down -> paro. */
		estop-gpios = <&gpiob_h 5 (GPIO_ACTIVE_LOW | GPIO_PULL_DOWN)>;
	};
};
