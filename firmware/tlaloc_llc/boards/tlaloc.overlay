/*
 * Señales que usa la app (el hardware está en boards/omrover/tlaloc).
 */
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	zephyr,user {
		/* servo del gripper a 50 Hz en eMIOS1 ch10 (PTA27) */
		pwms = <&emios1_pwm 10 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		pwm-names = "gripper";
		/* ACS712 en ADC0 precisión ch0 (PTD1) */
		io-channels = <&adc0 0>;
		/* INT de la BNO080, activo bajo, PTA21 = gpioa_h 5 (EIRQ3). El pull-up
		 * va aquí: gpio_pin_configure() borra el de pinctrl. */
		imu-int-gpios = <&gpioa_h 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* Paro físico: botón NC entre PTB21 y GND, PTB21 = gpiob_h 5 (EIRQ8).
		 * Activo alto: botón presionado o cable abierto -> pull-up -> paro. */
		estop-gpios = <&gpiob_h 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};
};
